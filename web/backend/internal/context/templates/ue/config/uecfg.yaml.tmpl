ue:
  # Which gNB this UE dials - resolved server-side from this subscriber's
  # own slice (Sd), since under the two-slice ULCL template more than one
  # gNB can be up at once and this UE only belongs to one of them.
  ranControlPlaneIp: "{{.RanIp}}"
  ranDataPlaneIp: "{{.RanIp}}"

  ranControlPlanePort: 31413
  ranDataPlanePort: 31414

  plmnId:
    mcc: "{{.Mcc}}"
    mnc: "{{.Mnc}}"
  msin: "{{.Msin}}"

  authenticationSubscription:
    encPermanentKey: "{{.PermanentKey}}"
    encOpcKey: "{{.OpValue}}"
    authenticationManagementField: "{{.Amf}}"
    sequenceNumber: "{{.Sqn}}"

  integrityAlgorithm:
    nia0: false
    nia1: false
    nia2: true
    nia3: false
  cipheringAlgorithm:
    nea0: true
    nea1: false
    nea2: false
    nea3: false

  pduSession:
    dnn: "{{.Dnn}}"
    snssai:
      sst: "{{.Sst}}"
      sd: "{{.Sd}}"

  accessType: "3GPP_ACCESS" # 3GPP_ACCESS, NON_3GPP_ACCESS

  nrdc:
    enable: false

  ueTunnelDevice: "ueTun"

logger:
  level: "info" # error, warn, info, debug, trace
